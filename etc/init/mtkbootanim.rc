service bootanim /system/bin/mtkbootvideo
    class core animation
    user graphics
    group graphics audio media_rw
    disabled
    oneshot
    writepid /dev/stune/top-app/tasks

# MTK add
service banim_shutmp3 /system/bin/mtkbootvideo shut
    class core animation
    user graphics
    group graphics audio media_rw
    disabled
    oneshot
    writepid /dev/stune/top-app/tasks

service banim_shutnomp3 /system/bin/mtkbootvideo shut
    class core animation
    user graphics
    group graphics audio media_rw
    disabled
    oneshot
    writepid /dev/stune/top-app/tasks
