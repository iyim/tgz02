#!/system/bin/sh

BB=/system/xbin/busybox

DATE="$BB date"
GREP="$BB grep"
TAIL="$BB tail"
CUT="$BB cut"
SED="$BB sed"
PRINTF="$BB printf"

LOG_DIR="/sdcard/admin"
LOG_DIR_RENAME=
[ -x "$BB" ] || exit

OUT_DIR=
PIDS=

trap '[ -n "$PIDS" ] && kill $PIDS >/dev/null 2>&1; exit'  INT TERM EXIT

# wait for sdcard mounted
#while ! $GREP -q " /storage/sdcard0 " /proc/mounts; do sleep 5; done
sleep 5

if ! [ -n "$OUT_DIR" -a -d "$OUT_DIR" ]; then
    num=$($PRINTF "%04d" $((`(cd "$LOG_DIR" && ls -d [0-9]*_*_*/) 2>/dev/null | $TAIL -n 1 | $CUT -d_ -f1 | $SED -e 's/^0*//g'`+1)))
    date=$(date "+%y%m%d_%H%M%S")
    OUT_DIR="$LOG_DIR/${num}_${date}"
fi

#if [ num -lt 100 ]; then
#limit log output content
if [ num -gt 1500 ]; then
        rm -fr "$LOG_DIR"
fi

mkdir -p "$OUT_DIR"

PIDS=$!
PIDS="$PIDS $!"

cp -fr /cache/admin $OUT_DIR
cp -fr /data/system/dropbox $OUT_DIR
cp -fr /data/tombstones $OUT_DIR
cp -fr /data/anr $OUT_DIR

#save console-ramoops
cp -fr /sys/fs/pstore/console-ramoops $OUT_DIR
cp -fr /sys/fs/pstore/rtrace-ramoops $OUT_DIR

rm -fr /cache/admin
rm -fr /data/system/dropbox/*
rm -fr /data/tombstones/*
rm -fr /data/anr/*

mkdir -p /cache/admin/apps
mkdir -p /cache/admin/kernel


start logcat_loose
start logcat_events
start klogd_loose

while [ "$(getprop dev.bootcomplete)" != "1" ] ; do sleep 1; done
date=$(date "+%y%m%d_%H%M%S")
OUT_DIR_RENAME="$LOG_DIR/${num}_${date}"
mv $OUT_DIR $OUT_DIR_RENAME

dumpsys procstats -a 2>&1 >> "$OUT_DIR_RENAME/processStats"
