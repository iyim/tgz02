<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@drawable/transparent" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:lpq="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:gravity="center" android:layout_gravity="center_horizontal" android:id="@id/ll_detected" android:background="@drawable/open_gesture_bg" android:visibility="gone" android:layout_width="@dimen/detected_width" android:layout_height="@dimen/detected_height" android:alpha="0.0">
