<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="#00ff0000"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#24272d" />
            <corners android:bottomLeftRadius="8.0dp" android:bottomRightRadius="8.0dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/color_ripple_force">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="8.0dp" />
                    <solid android:color="@color/color_ripple_force" />
                </shape>
            </item>
        </ripple>
    </item>
</ripple>
