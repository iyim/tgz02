#S1 camera status, 0:close, 1:available; default is 1
persist.camera.camavailable=1

#Set screen off timeout cache value to 10 minutes
persist.sys.cache.screen_off_timeout=600000

#Volume mode, 0:high level volume mode, 1:low level volume mode. default is 0.
persist.sys.volume.mode=0

#To print native crash and tombstone
persist.aee.core.direct=disable
