<?xml version="1.0" encoding="utf-8"?>
<!--
  T9-07 product UI. An ordinary, unprivileged app:
    - no permissions at all (it needs none: the bridge paths are readable by the app's group),
    - no sharedUserId, no root, no service, no receiver, no boot hook,
    - the only things it writes are its own files dir and <ui>/inbox/<event_id>.json.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tgz02.voice"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="27" />

    <application
        android:label="语音助手"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".ConversationActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
