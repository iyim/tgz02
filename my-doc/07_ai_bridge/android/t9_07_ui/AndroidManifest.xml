<?xml version="1.0" encoding="utf-8"?>
<!--
  T9-UI-02: V2 kid-friendly shell.

  The app is still an ordinary, unprivileged one: no permissions, no sharedUserId, no
  service, and no intent-reading code in any of the production activities.  Images ship
  in APK assets/ (aapt2 -A), not in res/.

  ConversationActivity / MoreActivity / SettingsActivity are GONE from the manifest:
  the V2 shell replaces them (skills / memory / settings pages).  Their code files stay
  in the repo for reference but are no longer compiled.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tgz02.voice"
    android:versionCode="9"
    android:versionName="1.7.0">

    <!-- T9-16：自有闹钟所需权限（全部为普通权限，无需用户授权弹窗） -->
    <uses-permission android:name="android.permission.SCHEDULE_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- T9-16 R6：读取 /sdcard/Alarms 里用户自放的铃声文件（危险权限，运行期申请） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="27" />

    <application
        android:name=".Tgz02App"
        android:label="布丁助手"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- the product: voice-first home with the buddy -->
        <activity
            android:name=".VoiceHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- T9-10.4: the product can be a home app. Declaring it is what makes the
                 "replace the factory desktop" step possible at all; whether the system
                 actually resolves to us is decided by the resolution table, see the report. -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- T9-UI-02: the four secondary top pages (Views inside, no new activities per skill) -->
        <activity android:name=".SkillsHomeActivity"  android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".MemoryCenterActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".SettingsHomeActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".AboutActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- T9-18: 应用管理（内置应用抽屉，替代第三方悬浮球的应用列表） -->
        <activity android:name=".AppListActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- T9-08C: multi-vendor model configuration (plain-text keys, editable, hot applied) -->
        <activity
            android:name=".ModelConfigActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- T9-10: the product backend. Own process (:backend), foreground, START_STICKY.
             It is the only party that polls the worker's public files; every page reaches it
             over AIDL. Not exported: only this package (same uid) may bind. -->
        <service
            android:name=".BackendService"
            android:process=":backend"
            android:exported="false" />

        <!-- T9-16：自有闹钟。AlarmReceiver 是 AlarmScheduler 的唯一 PendingIntent 目标；
             RingingActivity 由 receiver 直接 startActivity（Android 8.1 允许）；
             boot/time/timezone 变化统一走同一个 receiver 重算调度。 -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".AlarmBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".AlarmRingingService" android:exported="false" />
        <activity android:name=".AlarmRingingActivity" android:exported="false"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".AlarmSetConfirmActivity" android:exported="false"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- T9-16 R6：闹钟铃声选择页（技能中心 → 闹钟 → 闹钟铃声） -->
        <activity android:name=".AlarmSoundActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>
