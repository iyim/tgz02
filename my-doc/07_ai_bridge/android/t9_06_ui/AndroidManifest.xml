<?xml version="1.0" encoding="utf-8"?>
<!-- T9-06 minimal UI probe: ordinary third-party app, no root, no declared permission.
     It only writes into the validated inbox and reads the result / public state / provider. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tgz02.uibridge"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="27" />

    <application
        android:label="TG-Z02 UI bridge"
        android:debuggable="true"
        android:allowBackup="false">

        <activity
            android:name=".UiBridgeActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>